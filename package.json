{
  "name": "stick-siege",
  "private": true,
  "version": "0.1.0",
  "description": "A comedic medieval stick-figure tower defense game for HTML5.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
